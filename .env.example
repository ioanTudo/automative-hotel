# Copy this file to `.env` and fill in the values.

# SQLite database file (relative to the project root) for local development.
DATABASE_URL="file:./dev.db"

# Secret used to sign session JWTs. Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me"

# Public base URL of the app.
NEXTAUTH_URL="http://localhost:3000"

# Required for the support chatbot. The chatbot uses gpt-4o-mini.
OPENAI_API_KEY="sk-..."
